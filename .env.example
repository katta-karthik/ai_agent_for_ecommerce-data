# E-commerce AI Analytics Environment Variables
# Provide either a Google Gemini API key or a Groq API key (or both)

# Google Gemini API Key (Recommended)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (Alternative)
GROQ_API_KEY=your_groq_api_key_here

# Database path (default: ecommerce_optimized.db)
DATABASE_PATH=ecommerce_optimized.db
